# ============================================================
# Inspector Sipucol
# Normalizacion de archivos de texto
# ============================================================

* text=auto

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Los binarios, instaladores y snapshots completos
# se publican mediante GitHub Releases, no Git LFS.