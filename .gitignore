# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Entornos Python locales
.venv/
.venv-*/
**/.venv/
**/.venv-*/

# Node
node_modules/
**/node_modules/
.npm/
.yarn/
.pnpm-store/

# Vite / renderer generado
app/dist/
app/.desktop-renderer/
desktop-package/dist-desktop/

# Electron / paquetes generados
desktop-package/release/
desktop-package/release-final/
desktop-package/vendor/

# PyInstaller generado
desktop-clean-build/build/
desktop-clean-build/dist/
desktop-clean-stage/

# Entregas binarias
ENTREGA_COLABORADORES/

# Backups fisicos
# Se publicaran en ramas backup/archive mediante Git LFS
backups/

# Temporales
*.tmp
*.temp
*.log
*.bak
*.bak_*
*.old
*.orig
*.swp
*.swo
~$*

# Runtime local
runtime/
temp/
tmp/

# Secretos / configuracion local
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.iml

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Logs Electron/backend
backend-startup.log

# Cobertura
coverage/
htmlcov/
.coverage
